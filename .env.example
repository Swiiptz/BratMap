# Copier selon l'environnement visé (fichiers ignorés par git) :
#   .env.development.local  → `npm run dev` (projet Firebase de développement conseillé)
#   .env.staging.local      → `npm run build:staging` (recette)
#   .env.production.local   → `npm run build` (production)
# `npm run dev:offline` ignore Firebase et travaille dans le navigateur (voir .env.offline).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Facultatif : libellé affiché sous le logo (ex. « recette ») ; par défaut « dev » en développement, rien en production
VITE_ENV_LABEL=
# Facultatif : moteur de routage OSRM (par défaut les serveurs FOSSGIS d'OpenStreetMap, usage raisonnable)
VITE_ROUTING_URL=
# Facultatif : code d'accès global, en empreinte SHA-256 (protection légère, voir README)
VITE_ACCESS_CODE_SHA256=
